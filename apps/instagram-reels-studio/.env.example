# Configure in Vercel project settings; never commit actual values.
# Meta App ID used as client_id by Facebook Login for Business.
IG_APP_ID=1127709063315731
IG_APP_SECRET=
# Meta Login Configuration ID; its configured permissions replace OAuth scope.
IG_CONFIG_ID=2055560198307756
IG_REDIRECT_URI=https://<deployment-domain>/auth/instagram/callback
OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SUPABASE_URL=
# Accepts the legacy service_role JWT or a modern sb_secret_ key; server-only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reels-private
CRON_SECRET=
